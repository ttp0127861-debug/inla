# Neon Postgres — same branch for migrations, seeds, and local Lambda smoke tests.
# Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Users Lambda (local invoke only; deploy uses Terraform USER_POOL_ID)
# USER_POOL_ID=ap-southeast-1_xxxx

# Quotation attachments (optional local S3 tests)
# ATTACHMENTS_BUCKET=
# AWS_REGION=ap-southeast-1
# ATTACHMENTS_ENABLED=true
